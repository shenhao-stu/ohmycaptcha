FROM python:3.12-slim AS builder
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

FROM python:3.12-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl libatomic1 && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/.venv /app/.venv
COPY src/ ./src/
ENV PLAYWRIGHT_BROWSERS_PATH="/app/.cache/ms-playwright"
RUN /app/.venv/bin/playwright install-deps chromium && /app/.venv/bin/playwright install chromium
RUN useradd --create-home --uid 1001 appuser && chown -R appuser:appuser /app
USER appuser
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV SERVER_HOST="0.0.0.0" SERVER_PORT="8080"
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD curl -f http://localhost:8080/api/v1/health || exit 1
CMD ["uvicorn", "robotax_captcha.main:app", "--host", "0.0.0.0", "--port", "8080"]
